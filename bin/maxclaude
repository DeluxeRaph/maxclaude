#!/usr/bin/env bash
# maxclaude — persistent Claude Code session(s) in a zellij multiplexer.
#
# Open 1-4 Claude Code panes in a single terminal that survives closing your SSH
# connection. Re-running the same name/number just re-attaches (idempotent).
#
#   maxclaude               2x2 grid of 4 Claude panes   (= maxclaude 4, session max4)
#   maxclaude 1|2|3|4       N-pane numbered session      (session max<N>)
#   maxclaude <name>        named workspace, 4 panes; re-run to re-open it
#   maxclaude <name> N      named workspace with N panes  (1-4)
#   maxclaude ls            list open sessions, NUMBERED, with status flags
#   maxclaude attach <N>    attach session #N from the `maxclaude ls` list
#   maxclaude attach <name> attach one specific session by name
#   maxclaude close <N>     close session #N from the `maxclaude ls` list
#   maxclaude close <name>  close one specific session by name
#   maxclaude close         close the CURRENT session (run from inside it)
#   maxclaude close all     close EVERY session
#   maxclaude prune         GC dead/exited ghosts (auto-run by `ls`); alias `gc`
#   maxclaude kill [...]    legacy alias for close
#
# Inside zellij: detach with Ctrl-o then d. Move between panes with Alt+arrows.
#                Close the whole current window/session with Ctrl-q.
#
# This is a standalone executable (not a sourced shell function), so it works the
# same in bash or zsh. On Linux with `systemctl --user`, sessions are owned by a
# per-user systemd service and survive SSH disconnect via lingering. On systems
# without systemd, zellij's own background server keeps a detached session alive
# while you reconnect. Sessions never respawn after a full reboot.
#
# Override the zellij binary with $MAXCLAUDE_ZELLIJ if it lives somewhere unusual.

# --- zellij binary resolution -------------------------------------------------
MAXCLAUDE_ZELLIJ="${MAXCLAUDE_ZELLIJ:-$HOME/.local/bin/zellij}"
if [ ! -x "$MAXCLAUDE_ZELLIJ" ]; then
  _zj_path="$(command -v zellij 2>/dev/null || true)"
  [ -n "$_zj_path" ] && MAXCLAUDE_ZELLIJ="$_zj_path"
fi
if [ ! -x "$MAXCLAUDE_ZELLIJ" ] && ! command -v "$MAXCLAUDE_ZELLIJ" >/dev/null 2>&1; then
  echo "maxclaude: zellij not found (looked at \$MAXCLAUDE_ZELLIJ and PATH)." >&2
  echo "Install it by re-running the maxclaude installer, or set \$MAXCLAUDE_ZELLIJ." >&2
  exit 127
fi

# zellij paints its UI in 24-bit color; advertise truecolor so attaching emits
# real colors (the systemd unit sets the same for background panes).
export COLORTERM="${COLORTERM:-truecolor}"

# True only on a host with a working per-user systemd manager.
_maxclaude_has_systemd(){
  command -v systemctl >/dev/null 2>&1 && systemctl --user show-environment >/dev/null 2>&1
}

# Map a session name to its systemd --user unit instance (systemd hosts only).
_maxclaude_unit_for(){
  case "$1" in
    max[1-4]) printf 'maxclaude@%s.service\n' "${1#max}" ;;
    [1-4])    printf 'maxclaude@%s.service\n' "$1" ;;
    *)        printf 'maxclaude-named@%s.service\n' "$(systemd-escape "$1")" ;;
  esac
}

# Is this session wired to come back on boot? True only if someone explicitly
# `systemctl --user enable`d its unit — maxclaude never does that, so normally
# false for every session.
_maxclaude_is_boot_enabled(){
  _maxclaude_has_systemd || return 1
  [ "$(systemctl --user is-enabled "$(_maxclaude_unit_for "$1")" 2>/dev/null)" = enabled ]
}

# Garbage-collect dead state: delete EXITED zellij tombstones, and (on systemd)
# stop any still-active maxclaude unit whose zellij session is no longer live.
_maxclaude_prune(){
  local ZJ="$MAXCLAUDE_ZELLIJ" u inst name
  local live; live="$("$ZJ" list-sessions 2>/dev/null | sed -E 's/\x1b\[[0-9;]*m//g' \
                       | grep -vi 'EXITED' | awk 'NF{print $1}')"
  # 1) drop EXITED zellij tombstones
  "$ZJ" list-sessions 2>/dev/null | sed -E 's/\x1b\[[0-9;]*m//g' | grep -i 'EXITED' \
    | awk 'NF{print $1}' | while read -r name; do "$ZJ" delete-session -f "$name" >/dev/null 2>&1; done
  _maxclaude_has_systemd || return 0
  # 2) stop any ACTIVE maxclaude unit whose session is not live
  for u in $(systemctl --user list-units 'maxclaude@*' 'maxclaude-named@*' --no-legend 2>/dev/null | awk '{print $1}'); do
    inst="${u%.service}"
    case "$u" in
      maxclaude@*)       name="max${inst#maxclaude@}" ;;
      maxclaude-named@*) name="$(systemd-escape -u "${inst#maxclaude-named@}")" ;;
      *) continue ;;
    esac
    grep -qxF "$name" <<<"$live" && continue
    systemctl --user stop "$u" >/dev/null 2>&1
    systemctl --user reset-failed "$u" >/dev/null 2>&1
  done
}

# Canonical, ordered, de-duplicated list of LIVE session names (one per line).
_maxclaude_sessions(){
  "$MAXCLAUDE_ZELLIJ" list-sessions 2>/dev/null \
    | sed -E 's/\x1b\[[0-9;]*m//g' \
    | grep -vi 'EXITED' \
    | awk 'NF && !seen[$1]++{print $1}'
}

# Close one session by name or number: (on systemd) stop its unit, then kill it.
_maxclaude_close(){
  local ZJ="$MAXCLAUDE_ZELLIJ" sess="$1"
  case "$sess" in [1-4]) sess="max${sess}" ;; esac
  if _maxclaude_has_systemd; then
    systemctl --user disable --now "$(_maxclaude_unit_for "$sess")" >/dev/null 2>&1
  fi
  "$ZJ" kill-session "$sess" >/dev/null 2>&1
  "$ZJ" delete-session -f "$sess" >/dev/null 2>&1
  echo "Closed session: $sess."
}

# Create-or-attach a numbered (max1..max4) or named session. Idempotent.
_maxclaude_open(){
  local ZJ="$MAXCLAUDE_ZELLIJ"
  local cfg="${XDG_CONFIG_HOME:-$HOME/.config}/maxclaude"
  local sel="$1" panes="${2:-4}"

  if [ -n "${ZELLIJ:-}" ]; then
    echo "Already inside a zellij session (${ZELLIJ_SESSION_NAME:-?})." >&2
    echo "Detach with Ctrl-o d, then run maxclaude from a plain shell to (re)attach." >&2
    return 1
  fi

  # "max1".."max4" spelled out -> treat as the numbered session.
  case "$sel" in max[1-4]) sel="${sel#max}" ;; esac

  # Numbered sessions keep the classic layout-per-count behavior.
  case "$sel" in
    1|2|3|4)
      local n="$sel"
      if _maxclaude_has_systemd; then
        loginctl enable-linger "$USER" >/dev/null 2>&1
        systemctl --user start "maxclaude@${n}.service" >/dev/null 2>&1 \
          || { echo "Failed to start maxclaude@${n}.service:" >&2; systemctl --user status "maxclaude@${n}.service" --no-pager | head; return 1; }
        "$ZJ" attach "max${n}"
      else
        exec "$ZJ" --layout "cc${n}" attach -c "max${n}"
      fi
      return ;;
  esac

  # Named workspace: <name> [panes]. Re-running the same name re-opens it.
  local name="$sel"
  case "$panes" in 1|2|3|4) ;; *) panes=4 ;; esac
  local safe; safe="$(printf '%s' "$name" | tr -c 'A-Za-z0-9_.-' '-')"
  if [ -z "$safe" ] || [ "$safe" = "-" ]; then echo "invalid session name: $name" >&2; return 2; fi
  mkdir -p "$cfg"; printf '%s\n' "$panes" > "$cfg/${safe}.panes"
  if _maxclaude_has_systemd; then
    loginctl enable-linger "$USER" >/dev/null 2>&1
    local esc; esc="$(systemd-escape "$safe")"
    systemctl --user start "maxclaude-named@${esc}.service" >/dev/null 2>&1 \
      || { echo "Failed to start maxclaude-named@${safe}.service:" >&2; systemctl --user status "maxclaude-named@${esc}.service" --no-pager | head; return 1; }
    "$ZJ" attach "$safe"
  else
    exec "$ZJ" --layout "cc${panes}" attach -c "$safe"
  fi
}

_maxclaude_main(){
  local ZJ="$MAXCLAUDE_ZELLIJ"
  local sel="${1:-4}"

  # Subcommands that must work from anywhere, including inside a session.
  case "$sel" in
    -h|--help|help)
      sed -n '2,30p' "$0" | sed 's/^# \{0,1\}//'
      return ;;
    ls|list)
      _maxclaude_prune                       # purge dead/exited ghosts before listing
      local names; names="$(_maxclaude_sessions)"
      if [ -z "$names" ]; then echo "No maxclaude sessions."; return; fi
      local i=0 nm tags
      echo "maxclaude sessions:"
      while IFS= read -r nm; do
        [ -z "$nm" ] && continue
        i=$((i+1))
        tags="running"                       # _maxclaude_sessions returns live sessions only
        _maxclaude_is_boot_enabled "$nm" && tags="$tags, boot-persistent"
        [ "$nm" = "${ZELLIJ_SESSION_NAME:-}" ] && tags="$tags, current"
        printf '  %2d) %-22s [%s]\n' "$i" "$nm" "$tags"
      done <<< "$names"
      echo
      echo "Attach: maxclaude attach <number>    Close: maxclaude close <number>    GC: maxclaude prune"
      return ;;
    prune|gc)
      _maxclaude_prune
      echo "Pruned dead sessions. Remaining:"
      _maxclaude_main ls
      return ;;
    kill)
      local tgt="${2:-}"
      if [ "$tgt" = "all" ]; then
        local n u
        if _maxclaude_has_systemd; then
          for n in 1 2 3 4; do systemctl --user disable --now "maxclaude@${n}.service" >/dev/null 2>&1; done
          systemctl --user list-units 'maxclaude-named@*' --all --no-legend 2>/dev/null | awk '{print $1}' \
            | while read -r u; do systemctl --user disable --now "$u" >/dev/null 2>&1; done
        fi
        "$ZJ" kill-all-sessions -y >/dev/null 2>&1
        "$ZJ" delete-all-sessions -y -f >/dev/null 2>&1
        echo "ALL maxclaude sessions stopped."
        return
      fi
      [ -z "$tgt" ] && tgt="${ZELLIJ_SESSION_NAME:-}"
      if [ -z "$tgt" ]; then
        echo "usage: maxclaude kill <name|1-4|all>  (no target = current session; run from inside one)" >&2
        "$ZJ" list-sessions 2>/dev/null; return 2
      fi
      _maxclaude_close "$tgt"
      return ;;
    close)
      local tgt="${2:-}"
      case "$tgt" in all) _maxclaude_main kill all; return ;; esac
      [ -z "$tgt" ] && tgt="${ZELLIJ_SESSION_NAME:-}"
      if [ -z "$tgt" ]; then
        echo "usage: maxclaude close <number|name|all>  (no arg = current session)" >&2
        _maxclaude_main ls
        return 2
      fi
      # A pure number means "the Nth session from 'maxclaude ls'".
      case "$tgt" in
        ''|*[!0-9]*) ;;                       # has a non-digit -> treat as a name
        *)
          local nm; nm="$(_maxclaude_sessions | awk -v n="$tgt" 'NR==n')"
          if [ -z "$nm" ]; then
            echo "No session #${tgt}." >&2
            _maxclaude_main ls >&2
            return 2
          fi
          tgt="$nm"
          ;;
      esac
      _maxclaude_close "$tgt"
      return ;;
    attach|a|re|reattach)
      local tgt="${2:-}"
      if [ -z "$tgt" ]; then
        echo "usage: maxclaude attach <number|name>  (number from 'maxclaude ls')" >&2
        _maxclaude_main ls
        return 2
      fi
      # A pure number means "the Nth session from 'maxclaude ls'" (same index as close).
      case "$tgt" in
        ''|*[!0-9]*) ;;                       # has a non-digit -> treat as a name
        *)
          local nm; nm="$(_maxclaude_sessions | awk -v n="$tgt" 'NR==n')"
          if [ -z "$nm" ]; then
            echo "No session #${tgt}." >&2
            _maxclaude_main ls >&2
            return 2
          fi
          tgt="$nm"
          ;;
      esac
      _maxclaude_open "$tgt"
      return ;;
  esac

  # Create-or-attach the requested numbered/named session.
  _maxclaude_open "$sel" "${2:-4}"
}

_maxclaude_main "$@"
