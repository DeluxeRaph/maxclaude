[Unit]
Description=Persistent Claude Code zellij session (layout cc%i, session max%i)
Documentation=man:zellij(1)
# %i = 1|2|3|4  -> layout cc%i, session max%i
After=default.target

[Service]
Type=oneshot
RemainAfterExit=yes
# Keep the daemonized zellij server alive after the oneshot ExecStart returns.
KillMode=process
# Background server has no TERM/COLORTERM of its own; panes (and the apps in
# them) inherit these, so advertise a color-capable terminal for them.
Environment=TERM=xterm-256color
Environment=COLORTERM=truecolor
# Create the session in the background (no client). Idempotent: if it already
# exists this is a no-op. %h = the user's home directory.
ExecStart=%h/.local/bin/zellij --layout cc%i attach --create-background max%i
ExecStop=%h/.local/bin/zellij delete-session --force max%i

# No [Install] section, by design: this unit is NOT boot-persistent. maxclaude
# starts it with `systemctl --user start` (linger keeps it alive across SSH
# disconnect); it must never respawn on reboot.
