[Unit]
Description=Persistent Claude Code zellij workspace (named %I)
Documentation=man:zellij(1)
After=default.target

[Service]
Type=oneshot
RemainAfterExit=yes
# Keep the daemonized zellij server alive after the oneshot ExecStart returns.
KillMode=process
# Background server has no TERM/COLORTERM of its own; panes inherit these.
Environment=TERM=xterm-256color
Environment=COLORTERM=truecolor
# %I = unescaped session name. Pane layout comes from the per-session state file
# (~/.config/maxclaude/<name>.panes) written by the maxclaude command; missing or
# invalid -> 4 panes. Idempotent: if the session exists this is a no-op.
# %h = the user's home directory.
ExecStart=%h/.local/bin/maxclaude-svc start %I
ExecStop=%h/.local/bin/maxclaude-svc stop %I

# No [Install] section, by design: this unit is NOT boot-persistent. maxclaude
# starts it with `systemctl --user start` (linger keeps it alive across SSH
# disconnect); it must never respawn on reboot.
