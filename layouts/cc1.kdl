// maxclaude 1 — single persistent Claude pane.
layout {
    default_tab_template {
        pane size=1 borderless=true {
            plugin location="tab-bar"
        }
        children
        pane size=1 borderless=true {
            plugin location="compact-bar"
        }
    }
    pane_template name="cc" {
        command "bash"
        args "-lc" "exec $HOME/.local/bin/maxclaude-pane"
    }
    tab name="claude" focus=true {
        cc
    }
}
